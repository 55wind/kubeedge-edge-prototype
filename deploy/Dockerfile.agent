# Agent/Gateway 컨테이너 이미지 - 신규 작성 (1차년도 services/agent/Dockerfile 구조를
# 참고했으나 이 repo의 setuptools 패키지 레이아웃(src/eam)에 맞춰 새로 작성).
# 하나의 이미지를 agent(`python -m eam.agent`)와 gateway(`python -m eam.gateway`)
# 양쪽 K8s 매니페스트의 command 오버라이드로 공유한다 (k8s/agent-edge1.yaml,
# k8s/agent-edge2.yaml, k8s/gateway.yaml 참고).
#
# 빌드: deploy/build-images.sh 또는 아래를 repo 루트에서 직접 실행
#   docker build -f deploy/Dockerfile.agent -t eam-agent:v2 .
FROM python:3.10-slim

WORKDIR /app

# pyproject.toml의 readme="README.md" 참조 때문에 README.md도 함께 복사해야
# `pip install .`이 성공한다.
COPY pyproject.toml README.md ./
COPY src ./src

RUN pip install --no-cache-dir .

ENV PYTHONUNBUFFERED=1 \
    CERTS_DIR=/certs \
    AGENT_BUFFER_DIR=/buffer

# 기본 커맨드는 agent - k8s/gateway.yaml은 command를 ["python","-m","eam.gateway"]로
# 오버라이드해 같은 이미지를 게이트웨이로도 재사용한다.
CMD ["python", "-m", "eam.agent"]
