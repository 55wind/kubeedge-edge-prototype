# Manager 컨테이너 이미지 - 신규 작성 (1차년도 services/manager/Dockerfile 구조를
# 참고했으나 이 repo의 setuptools 패키지 레이아웃(src/eam)에 맞춰 새로 작성).
#
# 빌드: deploy/build-images.sh 또는 아래를 repo 루트에서 직접 실행
#   docker build -f deploy/Dockerfile.manager -t eam-manager:v2 .
FROM python:3.10-slim

WORKDIR /app

# pyproject.toml의 readme="README.md" 참조 때문에 README.md도 함께 복사해야
# `pip install .`이 성공한다.
COPY pyproject.toml README.md ./
COPY src ./src

RUN pip install --no-cache-dir .

ENV PYTHONUNBUFFERED=1 \
    CERTS_DIR=/certs \
    DB_URL=/data/manager.db

EXPOSE 8443

# TLS는 서비스 앞단(K8s Service/리버스 프록시)에서 종단하는 것을 전제로 하므로
# uvicorn 자체는 평문 HTTP로 8443을 리슨한다.
CMD ["python", "-m", "uvicorn", "eam.manager.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8443"]
